{
  "name": "@btpd/core",
  "version": "0.0.1",
  "description": "Language-agnostic core: 1-bit raster model, primitive and glyph rasterisation for thermal label printers",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "sample": "npm run build && node tools/render-sample.mjs",
    "tspl": "npm run build && node tools/render-tspl.mjs",
    "model": "npm run build && node tools/render-model.mjs"
  },
  "dependencies": {
    "opentype.js": "^1.3.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/opentype.js": "^1.3.10",
    "@zxing/library": "^0.21.3",
    "dejavu-fonts-ttf": "^2.37.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
