      "zpl": "^XA^FO60,60^GB200,100,100^FS^XZ",
      "maxDiffering": 0
    },
    {
      "id": "box-rounded",
      "zpl": "^XA^FO50,40^GB400,300,8,B,4^FS^XZ",
      "maxDiffering": 700,
      "note": "The corner arcs are anti-aliased in the reference; the straight edges match exactly."
    },
    {
      "id": "circle",
      "zpl": "^XA^FO100,60^GC200,12,B^FS^XZ",
      "maxDiffering": 0
    },
    {
      "id": "ellipse",
      "zpl": "^XA^FO80,60^GE500,250,10,B^FS^XZ",
      "maxDiffering": 80,
      "note": "Labelary anti-aliases the curve and this renderer does not, so the outermost row of each end differs by a dot."
    },
    {
      "id": "diagonal-right",
      "zpl": "^XA^FO100,60^GD400,240,8,B,R^FS^XZ",
      "maxDiffering": 200,
