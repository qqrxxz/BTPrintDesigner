{
  "comment": "ZPL samples rendered by Labelary as reference images. A sample with maxDiffering 0 must match dot for dot; anything else says in its note why it cannot, and the tolerance is set just above what is observed so a regression still fails. Sizes are in inches, as Labelary's URL wants them.",
  "size": {
    "width": 4,
    "height": 2
  },
  "samples": [
    {
      "id": "box",
      "zpl": "^XA^FO50,50^GB300,200,10^FS^XZ",
      "maxDiffering": 0
    },
    {
      "id": "box-thin",
      "zpl": "^XA^FO40,30^GB700,340,2^FS^XZ",
      "maxDiffering": 0
    },
    {
