{
  "name": "@btpd/app",
  "productName": "BTPrintDesigner",
  "version": "0.0.1",
  "private": true,
  "description": "Дизайнер этикеток для термопринтеров с честным 1-битным превью: TSPL, ZPL, CPCL",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "build": "npm run build:electron && npm run build:renderer",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "dev:web": "vite",
    "test": "vitest run",
    "icon": "node tools/make-icon.mjs",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "@btpd/core": "0.0.1",
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "electron": "44.4.5",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1"
  },
  "author": "Дмитрий Алексеев"
}
